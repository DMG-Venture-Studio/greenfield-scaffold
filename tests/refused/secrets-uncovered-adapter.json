{
 "date": "2026-10-08",
 "project": {
  "name": "Field Notes",
  "slug": "field-notes",
  "package": "field_notes",
  "summary": "Field Notes keeps a researcher's observations and lets an agent find and summarise them. It replaces a folder of text files nobody searches.",
  "database": "sqlite"
 },
 "repo": {
  "org": "example-org",
  "name": "field-notes",
  "visibility": "public",
  "remote": "created"
 },
 "surfaces": [
  "http",
  "mcp",
  "agent_tools"
 ],
 "nouns": [
  {
   "name": "note",
   "purpose": "One observation: what was seen, where and when.",
   "owns": [
    "notes"
   ],
   "operations": [
    "note.record",
    "note.show",
    "note.search"
   ],
   "roles": [
    "ops",
    "rules",
    "store",
    "model"
   ]
  },
  {
   "name": "summary",
   "purpose": "A written digest of the notes matching a question.",
   "owns": [
    "summaries"
   ],
   "operations": [
    "summary.write",
    "summary.show"
   ],
   "roles": [
    "ops",
    "render",
    "store",
    "model"
   ],
   "depends_on": [
    "note"
   ]
  }
 ],
 "adapters": [
  {
   "name": "model",
   "wraps": "anthropic",
   "implements": "Writer",
   "purpose": "Writes a digest from notes."
  }
 ],
 "first_operation": "note.record",
 "addons": {
  "serial_build": false,
  "agent_skills": false,
  "factory": false
 },
 "secrets": {
  "credentials": [
   {
    "name": "RAILWAY_STAGING_TOKEN",
    "vendor": "railway",
    "envs": [
     "staging"
    ]
   }
  ]
 },
 "_expect": "no credential names it"
}
